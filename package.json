{
  "name": "dotai",
  "version": "0.1.0",
  "private": true,
  "description": "Neutral-form AI tooling assets, plus an installer that emits the dialect each tool reads",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"**/*-test.mjs\" && node bin/check-docs.mjs",
    "check:docs": "node bin/check-docs.mjs",
    "format": "prettier --write . bin/install",
    "format:check": "prettier --check . bin/install"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
