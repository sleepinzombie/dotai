; Pin the public registry so `npm install` behaves the same here regardless of a
; machine-level or corporate registry configured in ~/.npmrc. There is one
; devDependency and nothing private, so there is no reason to resolve anywhere else.
registry=https://registry.npmjs.org/

; Record exact versions rather than ranges. Prettier's output changes between
; versions, so a caret range means two people can format the same file differently
; and produce diff noise that buries real changes.
save-exact=true

; Deliberately NOT setting engine-strict. The `engines` floor of 22 is a support
; decision — 18 and 20 are end-of-life — not a technical one: the code genuinely runs
; on 18+. Hard-failing someone on Node 20 would be wrong, so a warning is right.
